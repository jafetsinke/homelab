#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    network:
      version: 2
      ethernets:
        eth0:
          match:
            name: "en*"
          set-name: eth0
          dhcp4: true
  identity:
    hostname: ubuntu-server
    # Password is "ubuntu" (Packer SSH only during the build).
    password: "$6$exDY1mhS4KUYCE/2$zmn9ToZwTKLhCw.b4/b.ZRTIZM30JZ4QrOQ2aOXJ8yk96xpcCof0kxKwuX1kqLG/ygbJ1f8wxED22bTL4F46P0"
    username: packer
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - openssh-server
  package_upgrade: true
  updates: security
  # Guest tools: Packer attaches guest-tools.iso (SR "XCP-ng tools"); install into /target.
  late-commands:
    - |
      bash -ce '
      gt=/tmp/guest-tools
      mkdir -p "$gt"
      found=
      for dev in /dev/sr*; do
        [ -b "$dev" ] || continue
        umount "$gt" 2>/dev/null || true
        mount -o ro "$dev" "$gt" 2>/dev/null || continue
        if [ -f "$gt/Linux/install.sh" ]; then
          found=1
          break
        fi
        umount "$gt" 2>/dev/null || true
      done
      [ -n "$found" ] || {
        echo "guest-tools.iso not found: mount a CD with Linux/install.sh (tools_iso_name)" >&2
        exit 1
      }
      for bind in dev proc sys; do
        mount --bind /$bind /target/$bind
      done
      mkdir -p /target/mnt/guest-tools
      mount --bind "$gt" /target/mnt/guest-tools
      chroot /target /bin/bash -c "cd /mnt/guest-tools/Linux && ./install.sh -d ubuntu -m 24"
      umount /target/mnt/guest-tools
      for bind in sys proc dev; do
        umount /target/$bind
      done
      umount "$gt"
      echo "Installed guest tools from guest-tools.iso"
      '
    - curtin in-target --target=/target -- rm -f /etc/cloud/cloud-init.disabled
    - curtin in-target --target=/target -- rm -f /etc/cloud/cloud.cfg.d/90-installer-network.cfg
    - curtin in-target --target=/target -- rm -f /etc/cloud/cloud.cfg.d/subiquity-disable-cloudinit-networking.cfg
    - curtin in-target --target=/target -- cloud-init clean --logs --seed || true
    - curtin in-target --target=/target -- rm -rf /var/lib/cloud/instances /var/lib/cloud/instance /var/lib/cloud/data
    - curtin in-target --target=/target -- rm -f /var/log/cloud-init.log /var/log/cloud-init-output.log
  shutdown: reboot
