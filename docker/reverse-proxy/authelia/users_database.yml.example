---
# Copy to users_database.yml and replace the password hash:
#   cp users_database.yml.example users_database.yml
#   docker run --rm authelia/authelia authelia crypto hash generate argon2 --password 'yourpassword'
users:
  admin:
    disabled: false
    displayname: Admin
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME$REPLACE_ME'
    email: admin@jafet.dev
    groups:
      - admins
