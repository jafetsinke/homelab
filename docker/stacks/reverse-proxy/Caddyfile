{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	servers {
		trusted_proxies static 172.19.0.0/16
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(authelia_forward_auth) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Uri {uri}
	}
}

(proxy_headers) {
	header_up Host {host}
	header_up X-Forwarded-For {client_ip}
	header_up X-Forwarded-Proto https
}

(proxied) {
	import authelia_forward_auth
	reverse_proxy {args[0]} {
		import proxy_headers
	}
}

http://auth.jafet.dev, auth.jafet.dev {
	reverse_proxy authelia:9091
}

http://home.jafet.dev, home.jafet.dev {
	import proxied homepage:3000
}

http://dockhand.jafet.dev, dockhand.jafet.dev {
	import proxied dockhand:3000
}

http://dj-pool.jafet.dev, dj-pool.jafet.dev {
	import proxied navidrome:4533
}

http://*.jafet.dev, *.jafet.dev {
	header Content-Type "text/html; charset=utf-8"
	respond <<HTML
		<!DOCTYPE html>
		<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>404</title>
			<style>
				* { margin: 0; box-sizing: border-box; }
				body {
					min-height: 100vh;
					display: flex;
					align-items: center;
					justify-content: center;
					background: #1d1c1f;
					color: #8363db;
					font-family: system-ui, sans-serif;
					text-align: center;
				}
				h1 {
					font-size: 6rem;
					font-weight: 700;
					line-height: 1;
				}
				p {
					margin-top: 0.75rem;
					font-size: 1.25rem;
					font-weight: 400;
				}
			</style>
		</head>
		<body>
			<div>
				<h1>404</h1>
				<p>Page not found</p>
			</div>
		</body>
		</html>
		HTML 404
}